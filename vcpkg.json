{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "rmqcpp",
    "version": "1.0.0",
    "dependencies": [
      "boost-asio",
      "openssl",
      "bde",
      "pcre2",
      "zstd"
    ],
    "features": {
      "tests": {
        "description": "Build the rmqcpp unit and integration tests",
        "dependencies": [
          "gtest"
        ]
      }
    },
    "default-features": [
      "tests"
    ]
}
